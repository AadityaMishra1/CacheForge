{
  "name": "CacheForge Linux",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "args": {
      "CONDA_ENV_NAME": "cacheforge"
    }
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "overrideCommand": false,
  "remoteUser": "mambauser",
  "containerEnv": {
    "GROUP": "cacheforge"
  },
  "postCreateCommand": "conda info --envs",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}
